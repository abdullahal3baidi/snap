<!DOCTYPE html>
<html lang="ar" dir="rtl" style="background:#09090b">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>SnapVault</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SnapVault">
<meta name="theme-color" content="#09090b">
<style>
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;background:#09090b;color:#fafafa;min-height:100%}
  body{font-family:-apple-system,"Segoe UI",Tahoma,Arial,sans-serif;max-width:480px;margin:0 auto;
       padding:env(safe-area-inset-top) 16px calc(env(safe-area-inset-bottom) + 16px)}
  header{padding:16px 0;border-bottom:1px solid #222}
  h1{margin:0;font-size:22px}
  h1 span{color:#FFFC00}
  .sub{font-size:11px;color:#a1a1aa;margin-top:2px}
  .list{margin-top:16px;display:grid;gap:10px}
  .card{display:flex;align-items:center;gap:12px;background:#18181b;border:1px solid #27272a;
        border-radius:16px;padding:12px;cursor:pointer}
  .card:active{transform:scale(.98)}
  .av{width:56px;height:56px;border-radius:50%;background:#27272a;object-fit:cover;flex-shrink:0;
      border:2px solid #FFFC00}
  .info{flex:1;min-width:0}
  .name{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .user{font-size:12px;color:#FFFC00;direction:ltr;text-align:right}
  .arrow{color:#71717a;font-size:18px}
  footer{margin-top:24px;text-align:center;font-size:11px;color:#71717a}
</style>
</head>
<body>
<header>
  <h1>Snap<span>Vault</span></h1>
  <div class="sub">الحسابات</div>
</header>

<div class="list" id="list"></div>

<footer>للتثبيت على الآيفون: زر المشاركة ثم «إضافة إلى الشاشة الرئيسية»</footer>

<script>
// ✏️ اكتب اليوزرات هنا فقط (بدون @) — الاسم والصورة يتجلبون تلقائياً
var ACCOUNTS = [
  // 'najla_ali33',
  // 'username2',
];

(function () {
  var CACHE_KEY = 'snapvault_profile_cache';
  var cache = {};
  try { cache = JSON.parse(localStorage.getItem(CACHE_KEY)) || {}; } catch (e) {}

  function saveCache() { try { localStorage.setItem(CACHE_KEY, JSON.stringify(cache)); } catch (e) {} }

  var listEl = document.getElementById('list');

  ACCOUNTS.forEach(function (username) {
    username = String(username).trim().replace(/^@/, '');
    if (!username) return;

    var card = document.createElement('div'); card.className = 'card';
    card.onclick = function () { location.href = 'users.html?user=' + encodeURIComponent(username); };

    var img = document.createElement('img'); img.className = 'av'; img.alt = '';
    var info = document.createElement('div'); info.className = 'info';
    var n = document.createElement('div'); n.className = 'name'; n.textContent = username;
    var u = document.createElement('div'); u.className = 'user'; u.textContent = '@' + username;
    var arrow = document.createElement('div'); arrow.className = 'arrow'; arrow.textContent = '‹';
    info.appendChild(n); info.appendChild(u);
    card.appendChild(img); card.appendChild(info); card.appendChild(arrow);
    listEl.appendChild(card);

    // أظهر النسخة المحفوظة فوراً ثم حدّثها من سناب
    var c = cache[username];
    if (c) { if (c.avatar) img.src = c.avatar; if (c.name) n.textContent = c.name; }

    fetchProfile(username, img, n);
  });

  function fetchProfile(username, img, nameEl) {
    var target = 'https://www.snapchat.com/@' + encodeURIComponent(username);
    var proxies = [
      'https://api.allorigins.win/raw?url=' + encodeURIComponent(target),
      'https://corsproxy.io/?' + encodeURIComponent(target)
    ];
    (function tryNext(k) {
      if (k >= proxies.length) return;
      fetch(proxies[k]).then(function (r) {
        if (!r.ok) throw 0;
        return r.text();
      }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var avatar = '', name = '';

        // 1) من بيانات الصفحة
        var nd = doc.getElementById('__NEXT_DATA__');
        if (nd) {
          try {
            var p = JSON.parse(nd.textContent).props.pageProps;
            var prof = (p.userProfile && p.userProfile.publicProfileInfo) || p.publicProfileInfo || {};
            avatar = prof.profilePictureUrl || prof.squareHeroImageUrl || '';
            name = prof.title || '';
          } catch (e) {}
        }
        // 2) احتياطي: وسوم OpenGraph
        if (!avatar) {
          var og = doc.querySelector('meta[property="og:image"]');
          if (og) avatar = og.content;
        }
        if (!name) {
          var t = doc.querySelector('meta[property="og:title"]');
          if (t) name = t.content.replace(/\s*on Snapchat.*/i, '').replace(/\s*\(@.*?\)/, '');
        }

        if (!avatar && !name) throw 0;
        if (avatar) img.src = avatar;
        if (name) nameEl.textContent = name;
        cache[username] = { name: name, avatar: avatar };
        saveCache();
      }).catch(function () { tryNext(k + 1); });
    })(0);
  }
})();
</script>
</body>
</html>
